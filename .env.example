# Copy this file to .env and replace development placeholders locally.
APP_ENV=
SECRET_KEY=
# Public origin used in invitation links. Use your permanent HTTPS deployment URL in production.
APP_BASE_URL=http://127.0.0.1:5000
DATABASE_URL=

# Optional Brevo SMTP relay over STARTTLS (port 587).
# Leave credentials blank to create shareable invitations without sending email.
# Brevo SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Email sender
SMTP_FROM=
SMTP_FROM_NAME=Gastos

# PayMongo recurring subscriptions. Use plan IDs from the same mode as these keys.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PLAN_MONTHLY_ID=
PAYMONGO_PLAN_ANNUAL_ID=

# Class demos only: set to 1 to let the owner upgrade to Premium without a real payment.
DEMO_PAYMENTS=
